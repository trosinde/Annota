using Gtk 4.0;
using Adw 1;

// bootstrap-app-shell mockup 02.
menu primary_menu {
  section {
    item {
      label: _("New Capture");
      action: "win.new-capture";
    }

    item {
      label: _("Open…");
      action: "app.open-image";
    }

    item {
      label: _("Capture Library");
      action: "app.open-library";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("_About Annota");
      action: "app.about";
    }
  }
}

Adw.ApplicationWindow window {
  title: _("Annota");
  default-width: 1280;
  default-height: 800;
  width-request: 360;
  height-request: 294;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      MenuButton capture_menu_button {
        icon-name: "annota-capture-region-symbolic";
        tooltip-text: _("New Capture (Ctrl+N)");

        // Capture launcher (mockup 01 of add-screen-capture).
        popover: Popover capture_launcher {
          styles ["annota-launcher"]

          child: Box {
            orientation: vertical;
            spacing: 6;
            width-request: 332;

            Box {
              homogeneous: true;
              spacing: 4;
              styles ["annota-mode-group"]

              ToggleButton launcher_region_button {
                active: true;
                tooltip-text: _("Region");
                styles ["flat", "annota-mode-toggle"]

                child: Box {
                  orientation: vertical;
                  spacing: 2;
                  valign: center;

                  Image {
                    icon-name: "annota-capture-region-symbolic";
                    pixel-size: 24;
                  }

                  Label {
                    label: _("Region");
                    styles ["annota-mode-label"]
                  }

                  Label launcher_region_accel {
                    styles ["annota-mode-accel", "dim-label"]
                  }
                };
              }

              ToggleButton launcher_window_button {
                group: launcher_region_button;
                tooltip-text: _("Window");
                styles ["flat", "annota-mode-toggle"]

                child: Box {
                  orientation: vertical;
                  spacing: 2;
                  valign: center;

                  Image {
                    icon-name: "annota-capture-window-symbolic";
                    pixel-size: 24;
                  }

                  Label {
                    label: _("Window");
                    styles ["annota-mode-label"]
                  }

                  Label launcher_window_accel {
                    styles ["annota-mode-accel", "dim-label"]
                  }
                };
              }

              ToggleButton launcher_screen_button {
                group: launcher_region_button;
                tooltip-text: _("Screen");
                styles ["flat", "annota-mode-toggle"]

                child: Box {
                  orientation: vertical;
                  spacing: 2;
                  valign: center;

                  Image {
                    icon-name: "annota-capture-screen-symbolic";
                    pixel-size: 24;
                  }

                  Label {
                    label: _("Screen");
                    styles ["annota-mode-label"]
                  }

                  Label launcher_screen_accel {
                    styles ["annota-mode-accel", "dim-label"]
                  }
                };
              }
            }

            Box {
              spacing: 12;
              styles ["annota-launcher-row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;

                Label {
                  label: _("Delay");
                  xalign: 0;
                }

                Label {
                  label: _("Countdown before capturing");
                  xalign: 0;
                  styles ["caption", "dim-label"]
                }
              }

              SpinButton launcher_delay {
                valign: center;
                tooltip-text: _("Delay in seconds");
                adjustment: Adjustment {
                  lower: 0;
                  upper: 60;
                  step-increment: 1;
                  page-increment: 5;
                };
              }
            }

            Box {
              spacing: 12;
              styles ["annota-launcher-row"]

              Label {
                label: _("Include pointer");
                hexpand: true;
                xalign: 0;
              }

              Switch launcher_pointer {
                valign: center;
                tooltip-text: _("Include Pointer");
              }
            }

            Button launcher_capture_button {
              styles ["suggested-action", "annota-launcher-capture"]

              child: Box {
                halign: center;
                spacing: 12;

                Label launcher_capture_label {
                  styles ["heading"]
                }

                Label launcher_capture_accel {
                  styles ["annota-launcher-accel"]
                }
              };
            }

            Separator {
              margin-top: 6;
              margin-bottom: 6;
            }

            Button {
              action-name: "app.paste-image";
              styles ["flat", "annota-menu-row"]

              child: Box {
                spacing: 12;

                Image {
                  icon-name: "edit-copy-symbolic";
                }

                Label {
                  label: _("Paste Image From Clipboard");
                  hexpand: true;
                  xalign: 0;
                }

                Label launcher_paste_accel {
                  styles ["dim-label"]
                }
              };
            }

            Button {
              action-name: "app.open-image";
              styles ["flat", "annota-menu-row"]

              child: Box {
                spacing: 12;

                Image {
                  icon-name: "image-x-generic-symbolic";
                }

                Label {
                  label: _("Open Image…");
                  hexpand: true;
                  xalign: 0;
                }

                Label launcher_open_accel {
                  styles ["dim-label"]
                }
              };
            }
          };
        };
      }

      [end]
      MenuButton {
        primary: true;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        menu-model: primary_menu;
      }
    }

    content: Adw.ToastOverlay toast_overlay {
      child: Overlay {
        // Welcome (bootstrap-app-shell mockup 01): the mode cards start a capture, which
        // opens in the editor. The cards' shortcut keycaps are filled in from the settings.
        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: Box {
            orientation: vertical;
            valign: center;
            halign: center;
            margin-top: 24;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;

            Image {
              icon-name: "io.github.trosinde.Annota";
              pixel-size: 128;
              margin-bottom: 24;
            }

            Label {
              label: _("Capture Anything");
              wrap: true;
              justify: center;
              styles ["title-1"]
            }

            Label {
              label: _("Pick what to capture. The capture opens in the editor, ready to mark up. Every annotation stays editable until you export.");
              wrap: true;
              justify: center;
              max-width-chars: 52;
              margin-top: 12;
            }

            Box {
              spacing: 12;
              halign: center;
              homogeneous: true;
              margin-top: 30;

              Button welcome_region_card {
                tooltip-text: _("Capture a region");
                styles ["card", "annota-mode-card"]

                child: Box {
                  orientation: vertical;
                  spacing: 6;
                  valign: center;

                  Image {
                    icon-name: "annota-capture-region-symbolic";
                    pixel-size: 32;
                  }

                  Label {
                    label: _("Region");
                    styles ["heading"]
                  }

                  Box welcome_region_keys {
                    halign: center;
                    spacing: 4;
                  }
                };
              }

              Button welcome_window_card {
                tooltip-text: _("Capture a window");
                styles ["card", "annota-mode-card"]

                child: Box {
                  orientation: vertical;
                  spacing: 6;
                  valign: center;

                  Image {
                    icon-name: "annota-capture-window-symbolic";
                    pixel-size: 32;
                  }

                  Label {
                    label: _("Window");
                    styles ["heading"]
                  }

                  Box welcome_window_keys {
                    halign: center;
                    spacing: 4;
                  }
                };
              }

              Button welcome_screen_card {
                tooltip-text: _("Capture the screen");
                styles ["card", "annota-mode-card"]

                child: Box {
                  orientation: vertical;
                  spacing: 6;
                  valign: center;

                  Image {
                    icon-name: "annota-capture-screen-symbolic";
                    pixel-size: 32;
                  }

                  Label {
                    label: _("Screen");
                    styles ["heading"]
                  }

                  Box welcome_screen_keys {
                    halign: center;
                    spacing: 4;
                  }
                };
              }
            }

            Box {
              halign: center;
              spacing: 6;
              margin-top: 30;
              styles ["annota-welcome-hint"]

              Image {
                icon-name: "folder-symbolic";
              }

              Label {
                label: _("or open an image or .annota file with");
                wrap: true;
              }

              Box welcome_open_keys {
                spacing: 4;
                valign: center;
              }

              Label {
                label: _("— or drop it here");
              }
            }
          };
        };

        // Drop zone (mockup 14 of add-screen-capture), shown while an image is dragged in.
        [overlay]
        Box drop_zone {
          visible: false;
          can-target: false;
          orientation: vertical;
          styles ["annota-drop-zone"]

          Box {
            orientation: vertical;
            spacing: 12;
            halign: center;
            valign: center;
            vexpand: true;

            Box {
              halign: center;
              styles ["annota-drop-circle"]

              Image {
                icon-name: "image-x-generic-symbolic";
                pixel-size: 32;
                hexpand: true;
                vexpand: true;
              }
            }

            Label {
              label: _("Drop to Open as New Capture");
              styles ["title-4"]
            }

            Label {
              label: _("PNG, JPG, WebP or .annota");
              styles ["dim-label"]
            }
          }
        }
      };
    };
  };
}
