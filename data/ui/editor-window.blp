            Label ungroup_accel {
              styles ["dim-label"]
            }
          };
        }

        // Type properties (add-core-annotation-tools task 3.1; redline "Sidebar building
        // blocks"). `properties::rows` decides which rows a type shows and in which order.
        Box type_panel {
          visible: false;
          orientation: vertical;
          spacing: 18;

          Box row_sequence {
            orientation: vertical;
            spacing: 8;

            Label {
