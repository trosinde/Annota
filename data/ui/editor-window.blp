                    styles ["flat", "annota-end-tile"]

                    layout {
                      column: 0;
                      row: 1;
                    }

                    accessibility {
                      label: C_("end style", "Circle");
                    }

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      DrawingArea {
                        content-width: 44;
                        content-height: 16;
                        halign: center;
                        can-target: false;
                      }

                      Label {
                        label: C_("end style", "Circle");
                        styles ["caption", "dim-label"]
                      }
                    };
                  }

                  ToggleButton end_square {
                    group: end_none;
                    styles ["flat", "annota-end-tile"]

                    layout {
                      column: 1;
                      row: 1;
                    }

                    accessibility {
                      label: C_("end style", "Square");
                    }

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      DrawingArea {
                        content-width: 44;
                        content-height: 16;
                        halign: center;
                        can-target: false;
                      }

                      Label {
                        label: C_("end style", "Square");
                        styles ["caption", "dim-label"]
                      }
                    };
                  }

                  ToggleButton end_bar {
                    group: end_none;
                    styles ["flat", "annota-end-tile"]

                    layout {
                      column: 2;
                      row: 1;
                    }

                    accessibility {
                      label: C_("end style", "Bar");
                    }

                    child: Box {
                      orientation: vertical;
                      spacing: 4;

                      DrawingArea {
                        content-width: 44;
                        content-height: 16;
                        halign: center;
                        can-target: false;
                      }

                      Label {
                        label: C_("end style", "Bar");
                        styles ["caption", "dim-label"]
                      }
                    };
                  }
                };
              };
            }

            SpinButton start_size_spin {
              layout {
                column: 0;
                row: 3;
              }

              valign: center;
              hexpand: true;

              adjustment: Adjustment {
                lower: 25;
                upper: 400;
                step-increment: 5;
                page-increment: 25;
              };

              accessibility {
                label: _("Start size");
              }
            }

            SpinButton end_size_spin {
              layout {
                column: 1;
                row: 3;
              }

              valign: center;
              hexpand: true;

              adjustment: Adjustment {
                lower: 25;
                upper: 400;
                step-increment: 5;
                page-increment: 25;
              };

              accessibility {
                label: _("End size");
              }
            }
          }

          Box row_line_style {
            orientation: vertical;
            spacing: 8;

            Label {
              label: _("Line style");
              xalign: 0;
              styles ["dim-label"]
            }

            Box {
              homogeneous: true;
              styles ["annota-segmented"]

              ToggleButton line_solid {
                tooltip-text: _("Solid");
                child: DrawingArea {
                  content-width: 16;
                  content-height: 16;
                  can-target: false;
                };

                accessibility {
                  label: _("Solid");
                }
              }

              ToggleButton line_dashed {
                group: line_solid;
                tooltip-text: _("Dashed");
                child: DrawingArea {
                  content-width: 16;
                  content-height: 16;
                  can-target: false;
                };

                accessibility {
                  label: _("Dashed");
                }
              }

              ToggleButton line_dotted {
                group: line_solid;
                tooltip-text: _("Dotted");
                child: DrawingArea {
                  content-width: 16;
                  content-height: 16;
                  can-target: false;
                };

                accessibility {
                  label: _("Dotted");
                }
              }
            }
          }

          Box row_smoothing {
            orientation: vertical;
            spacing: 8;

            Label {
              label: _("Smoothing");
              xalign: 0;
              styles ["dim-label"]
            }

            Box {
              spacing: 12;

              Scale smoothing_scale {
                hexpand: true;
                draw-value: false;

                adjustment: Adjustment {
                  lower: 0;
                  upper: 100;
                  step-increment: 1;
                  page-increment: 10;
                };

                accessibility {
                  label: _("Smoothing");
                }
              }

              Label smoothing_value {
                width-chars: 5;
                xalign: 1;
                styles ["numeric"]
              }
            }
          }

          Box row_intensity {
            orientation: vertical;
            spacing: 8;

            Label {
              label: _("Intensity");
              xalign: 0;
              styles ["dim-label"]
            }

            Box {
              spacing: 12;

              Scale intensity_scale {
                hexpand: true;
                draw-value: false;

                adjustment: Adjustment {
                  lower: 0;
                  upper: 100;
                  step-increment: 1;
                  page-increment: 10;
                };

                accessibility {
                  label: _("Intensity");
                }
              }

              Label intensity_value {
                width-chars: 5;
                xalign: 1;
                styles ["numeric"]
              }
            }
          }

          Box row_redact_shape {
            orientation: vertical;
            spacing: 8;

            Label {
              label: _("Shape");
              xalign: 0;
              styles ["dim-label"]
            }

            Box {
              homogeneous: true;
              styles ["annota-segmented"]

              ToggleButton redact_rectangle {
                tooltip-text: _("Rectangle");
                child: DrawingArea {
                  content-width: 16;
                  content-height: 16;
                  can-target: false;
                };

                accessibility {
                  label: _("Rectangle");
                }
              }

              ToggleButton redact_ellipse {
                group: redact_rectangle;
                tooltip-text: _("Ellipse");
                child: DrawingArea {
                  content-width: 16;
                  content-height: 16;
                  can-target: false;
                };

                accessibility {
                  label: _("Ellipse");
                }
              }
            }
          }

          Box row_size {
            spacing: 12;

            Label {
              label: _("Size");
              hexpand: true;
              xalign: 0;
            }

            SpinButton size_spin {
              valign: center;
              width-request: 120;

              adjustment: Adjustment {
                lower: 6;
                upper: 200;
                step-increment: 1;
                page-increment: 10;
              };

              accessibility {
                label: _("Size");
              }
            }
          }

          Box row_value {
            spacing: 12;

            Box {
              orientation: vertical;
              hexpand: true;
              valign: center;

              Label {
                label: _("Value");
                xalign: 0;
              }

              Label {
                label: _("This marker only");
                xalign: 0;
                styles ["dim-label", "caption"]
              }
            }

            Entry value_entry {
              valign: center;
              width-request: 120;

              accessibility {
                label: _("Value of this marker");
              }
            }
          }

          Box row_next_value {
            spacing: 12;

            Label {
              label: _("Next value");
              hexpand: true;
              xalign: 0;
            }

            SpinButton next_value_spin {
              valign: center;
              width-request: 120;

              adjustment: Adjustment {
                lower: 1;
                upper: 9999;
                step-increment: 1;
                page-increment: 10;
              };

              accessibility {
                label: _("Next value");
              }
            }
          }

          Button row_restart {
            label: _("Restart Sequence");
          }

          Box row_opacity {
            orientation: vertical;
            spacing: 8;

            Label {
              label: _("Opacity");
              xalign: 0;
              styles ["dim-label"]
            }

            Box {
              spacing: 12;

              Scale opacity_scale {
                hexpand: true;
                draw-value: false;

                adjustment: Adjustment {
                  lower: 0;
                  upper: 100;
                  step-increment: 1;
                  page-increment: 10;
                };

                accessibility {
                  label: _("Opacity");
                }
              }

              Label opacity_value {
                width-chars: 5;
                xalign: 1;
                styles ["numeric"]
              }
            }
          }

          Box row_shadow {
            orientation: vertical;
            spacing: 12;

            ListBox {
              selection-mode: none;
              styles ["boxed-list"]

              Adw.ExpanderRow shadow_row {
                title: _("Shadow");
                show-enable-switch: true;

                ListBoxRow {
                  activatable: false;
                  selectable: false;

                  child: Box {
                    orientation: vertical;
                    spacing: 12;
                    margin-top: 12;
                    margin-bottom: 12;
                    margin-start: 12;
                    margin-end: 12;

                    Box {
                      orientation: vertical;
                      spacing: 8;

                      Label {
                        label: _("Colour");
                        xalign: 0;
                        styles ["dim-label"]
                      }

                      Box shadow_swatches {
                        orientation: vertical;
                        spacing: 6;
                      }
                    }

                    Box {
                      spacing: 12;

                      DrawingArea shadow_dial {
                        content-width: 56;
                        content-height: 56;
                        valign: center;
                        styles ["accent"]

                        accessibility {
                          label: _("Shadow angle");
                        }
                      }

                      Box {
                        orientation: vertical;
                        spacing: 6;
                        valign: center;

                        Label {
                          label: _("Angle");
                          xalign: 0;
                          styles ["dim-label"]
                        }

                        SpinButton shadow_angle {
                          valign: center;
                          width-request: 150;
                          wrap: true;

                          adjustment: Adjustment {
                            lower: 0;
                            upper: 359;
                            step-increment: 1;
                            page-increment: 15;
                          };

                          accessibility {
                            label: _("Shadow angle");
                          }
                        }
                      }
                    }

                    Box shadow_distance_row {
                      orientation: vertical;
                      spacing: 8;

                      Label {
                        label: _("Distance");
                        xalign: 0;
                        styles ["dim-label"]
                      }

                      Box {
                        spacing: 12;

                        Scale shadow_distance {
                          hexpand: true;
                          draw-value: false;

                          adjustment: Adjustment {
                            lower: 0;
                            upper: 30;
                            step-increment: 1;
                            page-increment: 10;
                          };

                          accessibility {
                            label: _("Shadow distance");
                          }
                        }

                        Label shadow_distance_value {
                          width-chars: 5;
                          xalign: 1;
                          styles ["numeric"]
                        }
                      }
                    }

                    Box shadow_blur_row {
                      orientation: vertical;
                      spacing: 8;

                      Label {
                        label: _("Blur");
                        xalign: 0;
                        styles ["dim-label"]
                      }

                      Box {
                        spacing: 12;

                        Scale shadow_blur {
                          hexpand: true;
                          draw-value: false;

                          adjustment: Adjustment {
                            lower: 0;
                            upper: 30;
                            step-increment: 1;
                            page-increment: 10;
                          };

                          accessibility {
                            label: _("Shadow blur");
                          }
                        }

                        Label shadow_blur_value {
                          width-chars: 5;
                          xalign: 1;
                          styles ["numeric"]
                        }
                      }
                    }

                    Box shadow_opacity_row {
                      orientation: vertical;
                      spacing: 8;

                      Label {
                        label: _("Opacity");
                        xalign: 0;
                        styles ["dim-label"]
                      }

                      Box {
                        spacing: 12;

                        Scale shadow_opacity {
                          hexpand: true;
                          draw-value: false;

                          adjustment: Adjustment {
                            lower: 0;
                            upper: 100;
                            step-increment: 1;
                            page-increment: 10;
                          };

                          accessibility {
                            label: _("Shadow opacity");
                          }
                        }

                        Label shadow_opacity_value {
                          width-chars: 5;
                          xalign: 1;
                          styles ["numeric"]
                        }
                      }
                    }
                  };
                }
              }
            }

            Button shadow_reset {
              visible: false;
              label: _("Reset Shadow");
            }
          }

          Box help_pen {
            spacing: 10;
            styles ["annota-note"]

            Image {
              icon-name: "dialog-information-symbolic";
              valign: start;
            }

            Label {
              label: _("Strokes stay editable vector paths. Hold <b>Shift</b> while drawing for a straight segment.");
              use-markup: true;
              wrap: true;
              xalign: 0;
              hexpand: true;
            }
          }

          Box help_polygon {
            spacing: 10;
            styles ["annota-note"]

            Image {
              icon-name: "dialog-information-symbolic";
              valign: start;
            }

            Label {
              label: _("Click to add a point. <b>Enter</b> or double-click finishes, clicking the first point closes the shape, <b>Backspace</b> removes the last point, <b>Esc</b> cancels.");
              use-markup: true;
              wrap: true;
              xalign: 0;
              hexpand: true;
            }
          }

          Box help_highlighter {
            spacing: 10;
            styles ["annota-note"]

            Image {
              icon-name: "dialog-information-symbolic";
              valign: start;
            }

            Label {
              label: _("Multiply keeps text under the highlight readable. Drag to mark a rectangle.");
              use-markup: true;
              wrap: true;
              xalign: 0;
              hexpand: true;
            }
          }

          Label help_callout {
            label: _("Drag + to add a tail. Drag a tail tip onto the body to remove it. The body grows with the text.");
            wrap: true;
            xalign: 0;
            styles ["dim-label"]
          }

          Box warning_redact {
            spacing: 10;
            styles ["annota-note", "annota-warning-note"]

            Image {
              icon-name: "dialog-warning-symbolic";
              valign: start;
            }

            Label {
              label: _("Blur and pixelate can sometimes be reversed. For passwords and personal data use <b>Solid</b>. Annota asks again before export.");
              use-markup: true;
              wrap: true;
              xalign: 0;
              hexpand: true;
            }
          }
        }

        Box arrange_box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: _("Arrange");
            xalign: 0;
            styles ["heading"]
          }

          Grid {
            column-spacing: 12;
            row-spacing: 8;
            column-homogeneous: true;

            Box {
              spacing: 8;

              layout {
                column: 0;
                row: 0;
              }

              Label {
                label: C_("arrange", "X");
                width-chars: 1;
                styles ["dim-label"]
              }

              Entry arrange_x {
                hexpand: true;
                width-chars: 4;
                input-purpose: number;

                accessibility {
                  label: _("X position");
                }
              }
            }

            Box {
              spacing: 8;

              layout {
                column: 1;
                row: 0;
              }

              Label {
                label: C_("arrange", "Y");
                width-chars: 1;
                styles ["dim-label"]
              }

              Entry arrange_y {
                hexpand: true;
                width-chars: 4;
                input-purpose: number;

                accessibility {
                  label: _("Y position");
                }
              }
            }

            Box {
              spacing: 8;

              layout {
                column: 0;
                row: 1;
              }

              Label {
                label: C_("arrange", "W");
                width-chars: 1;
                styles ["dim-label"]
              }

              Entry arrange_w {
                hexpand: true;
                width-chars: 4;
                input-purpose: number;

                accessibility {
                  label: _("Width");
                }
              }
            }

            Box {
              spacing: 8;

              layout {
                column: 1;
                row: 1;
              }

              Label {
                label: C_("arrange", "H");
                width-chars: 1;
                styles ["dim-label"]
              }

              Entry arrange_h {
                hexpand: true;
                width-chars: 4;
                input-purpose: number;

                accessibility {
                  label: _("Height");
                }
              }
            }
          }

          Box {
            spacing: 12;

            Label {
              label: _("Rotation");
              hexpand: true;
              xalign: 0;
            }

            SpinButton arrange_rotation {
              valign: center;
              width-chars: 5;

              adjustment: Adjustment {
                lower: -180;
                upper: 180;
                step-increment: 1;
                page-increment: 15;
              };

              accessibility {
                label: _("Rotation");
              }
            }
          }
        }

        Button select_all_type_button {
          visible: false;
        }

        Label group_note {
          visible: false;
          label: _("Dragging any member moves the whole group.");
          wrap: true;
          xalign: 0;
          styles ["dim-label"]
        }
      };
    }
  }
}

// The colour picker popover (redline "Colour picker popover", mockup 16): 300 px.
Popover colour_popover {
  styles ["annota-colour-popover"]

  child: Box {
    orientation: vertical;
    spacing: 12;
    width-request: 276;

    DrawingArea colour_area {
      content-height: 150;
      hexpand: true;

      accessibility {
        label: _("Saturation and brightness");
      }
    }

    DrawingArea colour_hue {
      content-height: 18;
      hexpand: true;

      accessibility {
        label: _("Hue");
      }
    }

    DrawingArea colour_alpha {
      content-height: 18;
      hexpand: true;

      accessibility {
        label: _("Opacity");
      }
    }

    Grid {
      column-spacing: 6;
      row-spacing: 4;

      Entry colour_hex {
        width-chars: 9;
        max-width-chars: 9;
        hexpand: true;

        layout {
          column: 0;
          row: 0;
        }

        accessibility {
          label: _("Hex colour");
        }
      }

      Entry colour_r {
        width-chars: 3;
        max-width-chars: 3;
        input-purpose: digits;

        layout {
          column: 1;
          row: 0;
        }

        accessibility {
          label: _("Red");
        }
      }

      Entry colour_g {
        width-chars: 3;
        max-width-chars: 3;
        input-purpose: digits;

        layout {
          column: 2;
          row: 0;
        }

        accessibility {
          label: _("Green");
        }
      }

      Entry colour_b {
        width-chars: 3;
        max-width-chars: 3;
        input-purpose: digits;

        layout {
          column: 3;
          row: 0;
        }

        accessibility {
          label: _("Blue");
        }
      }

      Label {
        label: C_("colour", "Hex");
        styles ["caption", "dim-label"]

        layout {
          column: 0;
          row: 1;
        }
      }

      Label {
        label: C_("colour", "R");
        styles ["caption", "dim-label"]

        layout {
          column: 1;
          row: 1;
        }
      }

      Label {
        label: C_("colour", "G");
        styles ["caption", "dim-label"]

        layout {
          column: 2;
          row: 1;
        }
      }

      Label {
        label: C_("colour", "B");
        styles ["caption", "dim-label"]

        layout {
          column: 3;
          row: 1;
        }
      }
    }

    Box {
      spacing: 8;

      Button colour_pick_screen {
        hexpand: true;
        halign: start;

        child: Box {
          spacing: 6;

          Image {
            icon-name: "color-select-symbolic";
          }

          Label {
            label: _("Pick From Screen");
          }
        };
      }

      Box colour_recent {
        spacing: 6;
        valign: center;
      }
    }
  };
}
