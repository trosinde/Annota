using Gtk 4.0;
using Adw 1;

// "Screen Access Denied" alert (mockup 08 of add-screen-capture). The mockup draws no failure
// state: reset_failed_label is the maintainer's decision, see add-screen-capture's design.md.

Adw.Dialog permission_dialog {
  content-width: 420;
  title: _("Screen Access Denied");

  child: Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 32;
    margin-bottom: 24;
    margin-start: 24;
    margin-end: 24;

    Image {
      icon-name: "dialog-warning-symbolic";
      pixel-size: 32;
      styles ["warning"]
    }

    Label {
      label: _("Screen Access Denied");
      wrap: true;
      justify: center;
      styles ["title-1"]
    }

    Label {
      label: _("GNOME has stored that Annota may not take screenshots. Choose <b>Ask Again</b>, then take the screenshot again. GNOME will ask you.");
      use-markup: true;
      wrap: true;
      justify: center;
      max-width-chars: 44;
    }

    Label {
      label: _("Nothing was captured.");
      wrap: true;
      justify: center;
      styles ["dim-label", "caption"]
    }

    // Shown when Ask Again fails.
    Label reset_failed_label {
      label: _("The answer could not be reset");
      visible: false;
      wrap: true;
      justify: center;
      max-width-chars: 44;
      styles ["error"]
    }

    Box {
      homogeneous: true;
      spacing: 12;
      margin-top: 12;

      Button close_button {
        label: _("Close");
        styles ["annota-dialog-button"]
      }

      Button ask_again_button {
        label: _("Ask Again");
        receives-default: true;
        styles ["annota-dialog-button", "suggested-action"]
      }
    }
  };
}
