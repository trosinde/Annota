using Gtk 4.0;
using Adw 1;

// "Screen Access Denied" alert (mockup 08 of add-screen-capture). The body, the command and the
// Copy Command button differ from the mockup and await the maintainer's approval: the Settings
// switch it names doesn't exist for an unsandboxed app (see add-screen-capture's design.md).

Adw.Dialog permission_dialog {
  content-width: 420;
  title: _("Screen Access Denied");

  child: Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 32;
    margin-bottom: 24;
    margin-start: 24;
    margin-end: 24;

    Image {
      icon-name: "dialog-warning-symbolic";
      pixel-size: 32;
      styles ["warning"]
    }

    Label {
      label: _("Screen Access Denied");
      wrap: true;
      justify: center;
      styles ["title-1"]
    }

    Label {
      label: _("GNOME has stored that Annota may not take screenshots. To be asked again, run this command in a terminal, then try again.");
      wrap: true;
      justify: center;
      max-width-chars: 44;
    }

    // Set from code: permission::reset_command().
    Label reset_command_label {
      selectable: true;
      wrap: true;
      wrap-mode: word_char;
      xalign: 0;
      max-width-chars: 44;
      styles ["monospace", "caption"]
    }

    Label {
      label: _("Nothing was captured.");
      wrap: true;
      justify: center;
      styles ["dim-label", "caption"]
    }

    Box {
      homogeneous: true;
      spacing: 12;
      margin-top: 12;

      Button close_button {
        label: _("Close");
        styles ["annota-dialog-button"]
      }

      Button copy_command_button {
        label: _("Copy Command");
        receives-default: true;
        styles ["annota-dialog-button", "suggested-action"]
      }
    }
  };
}
