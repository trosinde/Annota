using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog preferences_dialog {
  title: _("Preferences");
  search-enabled: true;
  content-width: 660;
  content-height: 720;

  Adw.PreferencesPage general_page {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Saving");
      description: _("Where Ctrl+S puts new captures");

      Adw.ActionRow save_folder_row {
        title: _("Save folder");

        [suffix]
        Button save_folder_button {
          valign: center;
          icon-name: "folder-symbolic";
          tooltip-text: _("Choose Save Folder…");
          styles ["flat"]
        }
      }

      Adw.EntryRow filename_pattern_row {
        title: _("File name pattern");
        styles ["monospace"]

        [suffix]
        MenuButton filename_pattern_help {
          valign: center;
          icon-name: "dialog-information-symbolic";
          tooltip-text: _("Pattern Reference");
          styles ["flat"]
          popover: Popover {
            child: Label {
              margin-start: 12;
              margin-end: 12;
              margin-top: 12;
              margin-bottom: 12;
              wrap: true;
              label: _("%Y year · %m month · %d day · %H hour · %M minute · %S second");
            };
          };
        }
      }

      Adw.ActionRow filename_example_row {
        title: _("Example");
        sensitive: false;
      }
    }

    Adw.PreferencesGroup {
      title: _("Export");

      Adw.ComboRow default_format_row {
        title: _("Default format");
        subtitle: _("Pre-selected in the Export dialog");
        model: StringList {
          strings [_("PNG"), _("JPG"), _("WebP"), _("PDF")]
        };
      }

      Adw.ActionRow export_folder_row {
        title: _("Export folder");

        [suffix]
        Button export_folder_button {
          valign: center;
          icon-name: "folder-symbolic";
          tooltip-text: _("Choose Export Folder…");
          styles ["flat"]
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Appearance");

      Adw.ActionRow {
        title: _("Style");
        subtitle: _("Follows the system light or dark style and accent colour");
        sensitive: false;

        [suffix]
        Label {
          valign: center;
          label: _("System");
          styles ["dim-label"]
        }
      }
    }
  }

  Adw.PreferencesPage capture_page {
    title: _("Capture");
    icon-name: "camera-photo-symbolic";

    // Holds the banner on libadwaita < 1.7, which has no AdwPreferencesPage:banner.
    Adw.PreferencesGroup banner_group {
      visible: false;
    }

    Adw.PreferencesGroup shortcuts_group {
      title: _("Global Shortcuts");

      Adw.ActionRow shortcut_region_row {
        title: _("Region capture");
        activatable: true;

        [suffix]
        ShortcutLabel shortcut_region_label {
          valign: center;
          disabled-text: "";
        }

        [suffix]
        Image {
          icon-name: "go-next-symbolic";
        }
      }

      Adw.ActionRow shortcut_window_row {
        title: _("Window capture");
        activatable: true;

        [suffix]
        ShortcutLabel shortcut_window_label {
          valign: center;
          disabled-text: "";
        }

        [suffix]
        Image {
          icon-name: "go-next-symbolic";
        }
      }

      Adw.ActionRow shortcut_screen_row {
        title: _("Screen capture");
        activatable: true;

        [suffix]
        ShortcutLabel shortcut_screen_label {
          valign: center;
          disabled-text: "";
        }

        [suffix]
        Image {
          icon-name: "go-next-symbolic";
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Capture");

      Adw.SwitchRow include_pointer_row {
        title: _("Include pointer");
        subtitle: _("Show the mouse pointer in captures");
      }

      Adw.SpinRow capture_delay_row {
        title: _("Default delay");
        adjustment: Adjustment {
          lower: 0;
          upper: 60;
          step-increment: 1;
          page-increment: 5;
        };
      }

      Adw.SwitchRow capture_all_monitors_row {
        title: _("Capture all monitors");
        subtitle: _("Screen mode captures every monitor instead of the one under the pointer");
      }

      Adw.ComboRow after_capture_row {
        title: _("After capture");
        model: StringList {
          strings [_("Open in Editor"), _("Copy to Clipboard"), _("Both")]
        };
      }
    }
  }
}

Adw.Banner shortcuts_banner {
  title: _("Global shortcuts are not active yet");
  button-label: _("Create GNOME Shortcuts");
  revealed: true;
  styles ["annota-warning-banner"]
}
