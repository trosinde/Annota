#: src/ui/editor/text.rs:229
msgid ""
"“{file}” uses document format {format}. It was saved with Annota {requires} "
"or newer."
msgstr ""
"„{file}“ verwendet das Dokumentformat {format}. Die Datei wurde mit Annota "
"{requires} oder neuer gespeichert."

#: src/ui/editor/text.rs:232
msgid "“{file}” uses document format {format}."
msgstr "„{file}“ verwendet das Dokumentformat {format}."

#: src/ui/editor/text.rs:238
msgid ""
"This is Annota {version}, which opens format {major}.x. Install Annota "
"{requires} or newer to open this file. The file was not changed."
msgstr ""
"Dies ist Annota {version}, das Format {major}.x öffnet. Installieren Sie "
"Annota {requires} oder neuer, um diese Datei zu öffnen. Die Datei wurde "
"nicht verändert."

#: src/ui/editor/text.rs:242
msgid ""
"This is Annota {version}, which opens format {major}.x. Install a newer "
"Annota to open this file. The file was not changed."
msgstr ""
"Dies ist Annota {version}, das Format {major}.x öffnet. Installieren Sie "
"eine neuere Annota-Version, um diese Datei zu öffnen. Die Datei wurde nicht "
"verändert."

#: src/ui/editor/text.rs:253
msgid ""
"This document has objects from a newer Annota. Update Annota to crop, "
"rotate, flip, resize or flatten it."
msgstr ""
"Dieses Dokument enthält Objekte aus einem neueren Annota. Aktualisieren Sie "
"Annota, um es zuzuschneiden, zu drehen, zu spiegeln, seine Größe zu ändern "
"oder es einzubrennen."

#: src/ui/editor/text.rs:259
msgid "Needs a newer Annota: this document has objects from a newer version"
msgstr ""
"Erfordert ein neueres Annota: Dieses Dokument enthält Objekte aus einer "
"neueren Version"

